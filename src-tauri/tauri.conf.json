{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxyGuard",
  "version": "0.5.0",
  "identifier": "com.proxyguard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProxyGuard",
        "width": 920,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Pause Codex / Claude network access when the VPN drops",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
